# Copy to .env (gitignored) on the mini PC and set a real value:
#   openssl rand -base64 18 | tr '+/' '-_'
# This is the one secret GitOps cannot carry in git.
POSTGRES_PASSWORD=change-me

# HTTPS: deSEC hostname whose A record points at this machine's LAN IP.
PLANT_HOST=plant-monitor.dedyn.io

# deSEC API token, scoped to that domain (Token management on desec.io).
DESEC_TOKEN=

# This machine's static LAN IP. Must match the firmware's mqtt_host.
PLANT_IP=192.168.0.50

# WebPush keys for sending notifications to the browser. 
# Generate with: npx web-push generate-vapid-keys
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=